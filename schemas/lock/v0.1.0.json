{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:envmason:schema:lock:0.1.0",
  "title": "EnvMason Lock",
  "description": "A deterministic, non-executable resolution for one target platform.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "generated_at",
    "executable",
    "confirmable",
    "profile",
    "target",
    "sources",
    "items",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"$ref": "#/$defs/digest"},
    "generated_at": {"type": "string", "format": "date-time"},
    "executable": {"const": false},
    "confirmable": {"const": false},
    "profile": {"$ref": "#/$defs/profile"},
    "target": {"$ref": "#/$defs/target"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "package_identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._+@/-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "os": {
      "enum": ["macos", "windows", "linux"]
    },
    "architecture": {
      "enum": ["amd64", "arm64", "386", "arm", "ppc64", "ppc64le", "s390x", "riscv64"]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "name", "digest"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "architecture"],
      "properties": {
        "os": {"$ref": "#/$defs/os"},
        "os_version": {"$ref": "#/$defs/version"},
        "architecture": {"$ref": "#/$defs/architecture"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "snapshot_at", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {"enum": ["package_catalog", "runtime_catalog", "platform_catalog"]},
        "uri": {"type": "string", "format": "uri", "pattern": "^https://"},
        "snapshot_at": {"type": "string", "format": "date-time"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module", "capability", "state", "observed", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "module": {"enum": ["base", "frontend_node"]},
        "capability": {"$ref": "#/$defs/identifier"},
        "state": {"enum": ["satisfied", "install_required", "conflict", "unresolved"]},
        "implementation": {"$ref": "#/$defs/implementation"},
        "observed": {
          "type": "array",
          "items": {"$ref": "#/$defs/observation"}
        },
        "reason": {
          "enum": [
            "compatible_installation_present",
            "installation_required",
            "conflicting_installation_present",
            "version_source_unavailable",
            "unsupported_platform",
            "unsupported_architecture",
            "unsupported_capability"
          ]
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "manager", "package_kind", "package_id", "version", "source_id", "conditions"],
      "properties": {
        "tool_id": {"$ref": "#/$defs/identifier"},
        "manager": {"enum": ["homebrew", "nvm", "system"]},
        "package_kind": {"enum": ["formula", "runtime", "system"]},
        "package_id": {"$ref": "#/$defs/package_identifier"},
        "version": {"$ref": "#/$defs/version"},
        "source_id": {"$ref": "#/$defs/identifier"},
        "conditions": {"$ref": "#/$defs/conditions"}
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architectures"],
      "properties": {
        "os": {"$ref": "#/$defs/os"},
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/architecture"}
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "version"],
      "properties": {
        "manager": {"enum": ["homebrew", "nvm", "system", "unknown"]},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["satisfied", "install_required", "conflict", "unresolved"],
      "properties": {
        "satisfied": {"type": "integer", "minimum": 0},
        "install_required": {"type": "integer", "minimum": 0},
        "conflict": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0}
      }
    }
  }
}
