{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:envmason:schema:profile:0.1.0",
  "title": "EnvMason Profile",
  "description": "A platform-neutral, non-executable declaration of desired developer capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "module": {
      "oneOf": [
        {
          "$ref": "#/$defs/base_module"
        },
        {
          "$ref": "#/$defs/frontend_node_module"
        }
      ]
    },
    "variant": {
      "type": "string",
      "enum": [
        "minimal",
        "standard"
      ],
      "default": "standard"
    },
    "base_module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "const": "base"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "options": {
          "$ref": "#/$defs/base_options"
        }
      }
    },
    "base_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build_tools": {
          "type": "boolean"
        },
        "terminal_configuration": {
          "type": "boolean"
        }
      }
    },
    "frontend_node_module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "const": "frontend_node"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "version_policy": {
          "$ref": "#/$defs/version_policy"
        },
        "options": {
          "$ref": "#/$defs/frontend_node_options"
        }
      }
    },
    "version_policy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "lts",
                "stable"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "pin"
          ],
          "properties": {
            "strategy": {
              "const": "exact"
            },
            "pin": {
              "$ref": "#/$defs/exact_version"
            }
          }
        }
      ],
      "default": {
        "strategy": "lts"
      }
    },
    "exact_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "frontend_node_options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corepack": {
          "type": "boolean"
        },
        "pnpm": {
          "type": "boolean"
        },
        "browser_testing": {
          "type": "boolean"
        }
      }
    }
  }
}
